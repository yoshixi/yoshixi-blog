---
import { LOCALE, SITE } from "@config";
import "@styles/base.css";
import { ClientRouter } from "astro:transitions";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

const socialImageURL = new URL(
  ogImage ?? SITE.ogImage ?? "og.png",
  Astro.url.origin
).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      url: `${profile}`,
    },
  ],
};
const defaultSiteLanguage = LOCALE.lang === "ja" ? "ja" : "en";
---

<!doctype html>
<html
  lang=`${LOCALE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta
      name="twitter:card"
      property="twitter:card"
      content="summary_large_image"
    />
    <meta name="twitter:url" property="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" property="twitter:title" content={title} />
    <meta
      name="twitter:description"
      property="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      property="twitter:image"
      content={socialImageURL}
    />
    <meta name="twitter:site" content="@yoshixi_dev" />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
      rel="preload"
      as="style"
      onload="this.onload=null; this.rel='stylesheet';"
      crossorigin
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js" async></script>

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-DFT3MRQ0NB"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // eslint-disable-next-line prefer-rest-params -- gtag.js expects the Arguments object
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-DFT3MRQ0NB");
    </script>
  </head>
  <body data-default-site-language={defaultSiteLanguage}>
    <slot />
    <script is:inline>
      (() => {
        if (window.__siteLanguageInitialized) return;
        window.__siteLanguageInitialized = true;

        const STORAGE_KEY = "site-language";
        const QUERY_KEY = "lang";
        const DEFAULT_LANGUAGE =
          document.body.dataset.defaultSiteLanguage === "ja" ? "ja" : "en";
        const SUPPORTED_LANGUAGES = new Set(["ja", "en"]);

        const normalizeLanguage = language =>
          SUPPORTED_LANGUAGES.has(language) ? language : null;

        const ensureLanguageInUrl = (rawUrl, language) => {
          const url = new URL(rawUrl, window.location.origin);
          url.searchParams.set(QUERY_KEY, language);
          return url.toString();
        };

        const applyLanguageToInternalLinks = language => {
          const anchors = document.querySelectorAll("a[href]");
          for (const anchor of anchors) {
            if (
              !(anchor instanceof HTMLAnchorElement) ||
              anchor.dataset.skipSiteLanguage === "true"
            ) {
              continue;
            }

            const rawHref = anchor.getAttribute("href");
            if (
              !rawHref ||
              rawHref.startsWith("#") ||
              rawHref.startsWith("mailto:") ||
              rawHref.startsWith("tel:")
            ) {
              continue;
            }

            const nextUrl = new URL(rawHref, window.location.origin);
            const isInternal = nextUrl.origin === window.location.origin;
            const hasFileExtension = /\.[a-z0-9]+$/i.test(nextUrl.pathname);
            const postLanguageFromPath =
              nextUrl.pathname.match(/^\/posts\/(ja|en)-/)?.[1];

            if (!isInternal || hasFileExtension) continue;
            if (
              postLanguageFromPath &&
              postLanguageFromPath !== language &&
              !anchor.dataset.forceLanguage
            ) {
              continue;
            }

            nextUrl.searchParams.set(QUERY_KEY, language);
            anchor.href = `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`;
          }
        };

        const updateLanguageSwitcherUI = language => {
          const buttons = document.querySelectorAll("[data-set-site-language]");
          for (const button of buttons) {
            const buttonLanguage = button.getAttribute(
              "data-set-site-language"
            );
            button.setAttribute(
              "aria-pressed",
              buttonLanguage === language ? "true" : "false"
            );
          }
        };

        const applyCardLanguageFilter = language => {
          const cards = document.querySelectorAll("[data-post-card='true']");
          if (!cards.length) return;

          const shownKeys = new Set();

          for (const card of cards) {
            const cardLanguage = card.getAttribute("data-post-language") ?? "";
            const cardTranslationKey =
              card.getAttribute("data-translation-key") ??
              `card-${Math.random().toString(16).slice(2)}`;

            const isLanguageMatch =
              cardLanguage.length === 0 || cardLanguage === language;
            if (!isLanguageMatch || shownKeys.has(cardTranslationKey)) {
              card.setAttribute("hidden", "hidden");
              continue;
            }

            shownKeys.add(cardTranslationKey);
            card.removeAttribute("hidden");
          }
        };

        const setDocumentLanguage = language => {
          document.documentElement.setAttribute("lang", language);
          document.documentElement.dataset.siteLanguage = language;
        };

        const getLanguageFromCurrentUrl = () => {
          const url = new URL(window.location.href);
          return normalizeLanguage(url.searchParams.get(QUERY_KEY));
        };

        const applyLanguage = (language, options = {}) => {
          const { updateUrl = true } = options;

          setDocumentLanguage(language);
          localStorage.setItem(STORAGE_KEY, language);

          updateLanguageSwitcherUI(language);
          applyCardLanguageFilter(language);
          applyLanguageToInternalLinks(language);

          if (updateUrl) {
            const currentUrl = ensureLanguageInUrl(
              window.location.href,
              language
            );
            window.history.replaceState(window.history.state, "", currentUrl);
          }

          window.dispatchEvent(
            new CustomEvent("site-language-change", {
              detail: { language },
            })
          );
        };

        const maybeNavigateToTranslatedPost = language => {
          const selector = `[data-translation-target-language="${language}"]`;
          const translationLink = document.querySelector(selector);
          if (!(translationLink instanceof HTMLAnchorElement)) return false;

          window.location.assign(
            ensureLanguageInUrl(translationLink.href, language)
          );
          return true;
        };

        const initializeLanguage = ({ updateUrl }) => {
          const activeLanguage =
            getLanguageFromCurrentUrl() ?? DEFAULT_LANGUAGE;
          applyLanguage(activeLanguage, { updateUrl });
        };

        document.addEventListener("click", event => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const languageButton = target.closest("[data-set-site-language]");
          if (!(languageButton instanceof HTMLElement)) return;

          const nextLanguage = normalizeLanguage(
            languageButton.getAttribute("data-set-site-language")
          );
          if (!nextLanguage) return;

          event.preventDefault();
          if (maybeNavigateToTranslatedPost(nextLanguage)) return;

          applyLanguage(nextLanguage, { updateUrl: true });
        });

        window.addEventListener("site-language-refresh", () => {
          const currentLanguage =
            normalizeLanguage(document.documentElement.dataset.siteLanguage) ??
            DEFAULT_LANGUAGE;
          applyCardLanguageFilter(currentLanguage);
        });

        initializeLanguage({ updateUrl: !getLanguageFromCurrentUrl() });
        document.addEventListener("astro:after-swap", () => {
          initializeLanguage({ updateUrl: !getLanguageFromCurrentUrl() });
        });
      })();
    </script>
  </body>
</html>
